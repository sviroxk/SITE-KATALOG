{
  "name": "veyra",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,green \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "build": "npm run build --workspace frontend",
    "build:all": "npm run build --workspace backend && npm run build --workspace frontend",
    "lint": "oxlint frontend/app frontend/src frontend/components backend/src",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:seed": "npm run db:seed --workspace backend"
  },
  "devDependencies": {
    "concurrently": "8.2.2",
    "oxlint": "1.91.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
