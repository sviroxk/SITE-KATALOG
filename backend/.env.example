# Express server
PORT=4000
NODE_ENV=development

# PostgreSQL URL; local value must match POSTGRES_PASSWORD in the root .env file
DATABASE_URL=postgresql://sitekatalog:sitekatalog_dev@localhost:5432/sitekatalog

# Authentication (replace with a unique random value before deployment)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Browser origin allowed by the backend CORS policy
CLIENT_URL=http://localhost:3000

# External catalog credentials; keep these server-side only
TMDB_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
GOOGLE_BOOKS_API_KEY=
STEAM_API_KEY=

# Optional avatar/object storage configuration
UPLOAD_DIR=uploads
MAX_AVATAR_SIZE_BYTES=2097152
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
