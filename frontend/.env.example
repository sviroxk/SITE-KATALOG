# Public Supabase project endpoint and anon/publishable key only
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public API endpoint for browser requests; never put provider keys here
NEXT_PUBLIC_API_URL=http://localhost:4000

# TMDB_API_KEY is server-side only; keep it in Supabase Edge Function Secrets.
