# Local Docker Compose PostgreSQL credentials; these are development-only values.
POSTGRES_DB=sitekatalog
POSTGRES_USER=sitekatalog
POSTGRES_PASSWORD=sitekatalog_dev
POSTGRES_PORT=5432

# Optional pgAdmin profile: docker compose --profile tools up
PGADMIN_DEFAULT_EMAIL=admin@example.local
PGADMIN_DEFAULT_PASSWORD=admin_dev
PGADMIN_PORT=5050
